    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@rushstack/eslint-patch": "1.10.5",
    "@vue/eslint-config-typescript": "14.9.0",
    "oxlint": "1.82.0",
    "eslint-plugin-oxlint": "^1.82.0",
    "eslint": "10.10.0",
    "eslint-config-love": "156.0.0",
